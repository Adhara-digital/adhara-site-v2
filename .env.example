# Variables à recopier dans Vercel (Settings > Environment Variables).
# Ne jamais mettre les vraies valeurs dans ce fichier : il part sur GitHub.

# Clé Resend, pour l'envoi des messages du formulaire.
# https://resend.com > API Keys. Elle commence par re_
RESEND_API_KEY=

# Adresse qui reçoit les messages du site (côté serveur uniquement).
CONTACT_TO=adhara.information@gmail.com

# Expéditeur affiché. Tant qu'aucun domaine n'est vérifié chez Resend,
# laisser vide : le site utilisera onboarding@resend.dev
CONTACT_FROM=
